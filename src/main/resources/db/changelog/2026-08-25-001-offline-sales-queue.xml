<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Create offline_sales_queue table for offline-first sales -->
    <changeSet id="2026-08-25-001-create-offline-sales-queue" author="system">

        <createTable tableName="offline_sales_queue">
            <!-- Primary Key & IDs -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Shop & User Context -->
            <column name="shop_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Idempotency & Device Tracking -->
            <column name="client_txn_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true" uniqueConstraintName="unique_shop_client_txn"/>
            </column>
            <column name="device_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Status & Sale Tracking -->
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="offline_sale_no" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Request & Response Data -->
            <column name="request_payload_json" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>

            <!-- After Processing -->
            <column name="sale_id" type="BIGINT"/>
            <column name="invoice_number" type="VARCHAR(255)"/>
            <column name="invoice_signed_url" type="VARCHAR(2048)"/>

            <!-- Error Tracking -->
            <column name="error_code" type="VARCHAR(100)"/>
            <column name="error_message" type="VARCHAR(1000)"/>

            <!-- Retry Tracking -->
            <column name="retry_count" type="INT" defaultValue="0">
                <constraints nullable="false"/>
            </column>

            <!-- Metadata -->
            <column name="metadata_json" type="LONGTEXT"/>

            <!-- Timestamps -->
            <column name="synced_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <!-- Audit -->
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <!-- Composite Unique Constraint for Idempotency -->
        <addUniqueConstraint
            tableName="offline_sales_queue"
            columnNames="shop_id,client_txn_id"
            constraintName="uk_offline_sales_queue_shop_client_txn"/>

        <!-- Indexes for Query Performance -->
        <createIndex tableName="offline_sales_queue" indexName="idx_offline_sales_queue_shop_status">
            <column name="shop_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex tableName="offline_sales_queue" indexName="idx_offline_sales_queue_user_status">
            <column name="user_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex tableName="offline_sales_queue" indexName="idx_offline_sales_queue_device_id">
            <column name="device_id"/>
        </createIndex>

        <createIndex tableName="offline_sales_queue" indexName="idx_offline_sales_queue_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="offline_sales_queue" indexName="idx_offline_sales_queue_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="offline_sales_queue" indexName="idx_offline_sales_queue_sale_id">
            <column name="sale_id"/>
        </createIndex>

        <!-- Partitioning Strategy (optional, for large deployments) -->
        <!-- If table grows beyond 10M rows, add partition by RANGE(shop_id) -->

    </changeSet>

</databaseChangeLog>
