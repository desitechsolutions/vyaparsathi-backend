# =============================================================================
# VyaparSathi Backend — Environment Variables (example)
#
# Copy this file to `.env` in the project root and fill in real values.
# NEVER commit the populated `.env` file. Rotate any value that has been
# checked into source control.
# =============================================================================

# ---------- JWT ----------
# Access-token TTL (ms). Phase 0 tightens this to 15 minutes.
JWT_EXPIRATION=900000

# ---------- Razorpay AutoPay ----------
# Register a test app at https://dashboard.razorpay.com/app/keys
SUBSCRIPTION_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- NIC e-Invoicing ----------
EINVOICE_PROVIDER=MOCK
EINVOICE_NIC_BASE_URL=https://einv-apisandbox.nic.in
EINVOICE_NIC_CLIENT_ID=
EINVOICE_NIC_CLIENT_SECRET=
EINVOICE_NIC_USERNAME=
EINVOICE_NIC_PASSWORD=
EINVOICE_NIC_SANDBOX=true
EINVOICE_NIC_TIMEOUT_MS=10000

# ---------- CORS ----------
APP_ALLOWED_ORIGINS=http://localhost:3000
